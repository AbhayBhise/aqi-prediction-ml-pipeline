import React, { useEffect, useState } from 'react';
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from 'recharts';
import { Cloud, CloudRain, Sun, Moon, Star, Wind, MapPin, Loader2, BookOpen } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import api from '../services/api';
import useDashboardStore from '../store/useDashboardStore';

const Dashboard = () => {
  const {
    dashboardData, setDashboardData,
    weatherData, setWeatherData,
    location, setLocation,
    loading, setLoading,
    error, setError
  } = useDashboardStore();

  const [permissionDenied, setPermissionDenied] = useState(false);
  const [isDayTime, setIsDayTime] = useState(true);
  const [sunPosition, setSunPosition] = useState({ x: 0, y: 0 });
  const [moonPosition, setMoonPosition] = useState({ x: 0, y: 0 });
  const [currentTime, setCurrentTime] = useState(new Date());

  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentTime(new Date());
    }, 60000); // update every minute
    return () => clearInterval(timer);
  }, []);

  useEffect(() => {
    const hour = currentTime.getHours();
    const minutes = currentTime.getMinutes();
    const timeInHours = hour + minutes / 60;
    
    // Day time: 6 AM to 6 PM (18:00)
    const isDay = hour >= 6 && hour < 18;
    setIsDayTime(isDay);

    // Calculate positions based on a semi-circle path
    // Let x range from -50vw to 50vw
    // Let y range from 0 to -40vh (zenith)
    
    if (isDay) {
      // Sun path from 6 to 18
      const progress = (timeInHours - 6) / 12; // 0 at 6AM, 0.5 at 12PM, 1 at 6PM
      const angle = progress * Math.PI; // 0 to PI
      setSunPosition({
        x: -50 + progress * 100, // percentage of screen width
        y: Math.sin(angle) * -40 // percentage of screen height (negative is up)
      });
    } else {
      // Moon path from 18 to 6 (next day)
      let adjustedTime = timeInHours >= 18 ? timeInHours - 18 : timeInHours + 6;
      const progress = adjustedTime / 12;
      const angle = progress * Math.PI;
      setMoonPosition({
        x: -50 + progress * 100,
        y: Math.sin(angle) * -40
      });
    }
    
    // Set theme in app
    document.documentElement.dataset.theme = isDay ? 'light' : 'dark';
    if (isDay) {
      document.documentElement.classList.add('theme-light');
    } else {
      document.documentElement.classList.remove('theme-light');
    }
  }, [currentTime]);

  useEffect(() => {
    if (!dashboardData && !loading) {
      fetchDashboardData();
    }
    if (!weatherData && !loading) {
      fetchLocationAndWeather();
    }
  }, []);

  const fetchDashboardData = async () => {
    setLoading(true);
    try {
      const res = await api.get('/eda_data');
      setDashboardData(res.data || []);
    } catch (err) {
      console.error(err);
      setError('Failed to fetch dashboard data');
      setDashboardData([]);
    } finally {
      setLoading(false);
    }
  };

  const fetchLocationAndWeather = async () => {
    try {
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          async (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            setLocation({ lat, lon });
            await fetchWeather(lat, lon, null);
          },
          async (error) => {
            console.warn("Geolocation denied or error. Falling back to IP geolocation.", error);
            try {
              const geoRes = await fetch('https://ipapi.co/json/');
              const geoData = await geoRes.json();
              if(geoData && geoData.latitude && geoData.longitude) {
                const lat = parseFloat(geoData.latitude);
                const lon = parseFloat(geoData.longitude);
                setLocation({ lat, lon });
                await fetchWeather(lat, lon, geoData.city);
              } else {
                throw new Error("Invalid IP API response");
              }
            } catch (err) {
              setPermissionDenied(true);
              const defaultLat = 28.6139;
              const defaultLon = 77.2090;
              setLocation({ lat: defaultLat, lon: defaultLon });
              await fetchWeather(defaultLat, defaultLon, "New Delhi");
            }
          },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
      } else {
        const defaultLat = 28.6139;
        const defaultLon = 77.2090;
        setLocation({ lat: defaultLat, lon: defaultLon });
        fetchWeather(defaultLat, defaultLon, "New Delhi");
      }
    } catch(e) {
      console.error(e);
    }
  };

  const fetchWeather = async (lat, lon, preFetchedCity) => {
    try {
      const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=temperature_2m,relative_humidity_2m,wind_speed_10m`);
      const data = await res.json();
      
      let cityName = preFetchedCity;
      if (!cityName) {
        try {
          const geoRes = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
          const geoData = await geoRes.json();
          cityName = geoData.address.city || geoData.address.town || geoData.address.village || geoData.address.county || "Your Location";
        } catch (e) {
          console.error("Reverse geocoding failed", e);
          cityName = "Your Location";
        }
      }

      setWeatherData({
        ...data.current_weather,
        city: cityName,
        humidity: data.hourly.relative_humidity_2m[0] // approximation for current hour
      });
    } catch (err) {
      console.error("Failed to fetch weather", err);
    }
  };

  const chartData = (dashboardData && dashboardData.aqi_distribution) 
    ? Object.keys(dashboardData.aqi_distribution).map(key => ({
        name: key,
        count: dashboardData.aqi_distribution[key]
      })) 
    : [];

  const getWeatherIcon = (weathercode) => {
    if (weathercode === undefined) return <Sun className="w-12 h-12 text-yellow-400" />;
    if (weathercode <= 3) return <Sun className="w-12 h-12 text-yellow-400" />;
    if (weathercode >= 45 && weathercode <= 48) return <Cloud className="w-12 h-12 text-slate-400" />;
    if (weathercode >= 51 && weathercode <= 67) return <CloudRain className="w-12 h-12 text-blue-400" />;
    if (weathercode >= 71 && weathercode <= 77) return <Cloud className="w-12 h-12 text-slate-200" />;
    if (weathercode >= 80 && weathercode <= 82) return <CloudRain className="w-12 h-12 text-blue-500" />;
    if (weathercode >= 95) return <Wind className="w-12 h-12 text-indigo-400" />;
    return <Sun className="w-12 h-12 text-yellow-400" />;
  };

  return (
    <div className="pb-8 min-h-screen relative overflow-hidden bg-transparent">
      {/* Background layer inside App.jsx or Dashboard depending on styling. We removed solid colors to allow global background. */}
      {/* If we want local background, we handle it here: */}
      <div className={`absolute inset-0 transition-colors duration-1000 -z-10 ${isDayTime ? 'bg-gradient-to-br from-sky-300 via-blue-200 to-amber-100' : 'bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950'}`}>
        <AnimatePresence>
          {isDayTime ? (
            <motion.div
              key="day"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              transition={{ duration: 1 }}
              className="absolute inset-0 overflow-hidden"
            >
              {/* Dynamic Sun */}
              <motion.div 
                className="absolute text-yellow-500 opacity-90 shadow-yellow-300 drop-shadow-[0_0_50px_rgba(250,204,21,0.8)]"
                animate={{ 
                  left: `${50 + sunPosition.x}%`, 
                  top: `${50 + sunPosition.y}%`,
                  rotate: 360
                }}
                transition={{ 
                  left: { type: "spring", stiffness: 10, damping: 20 },
                  top: { type: "spring", stiffness: 10, damping: 20 },
                  rotate: { duration: 120, repeat: Infinity, ease: "linear" }
                }}
                style={{ transform: 'translate(-50%, -50%)' }}
              >
                <Sun size={200} fill="currentColor" />
              </motion.div>
              {/* Clouds */}
              <motion.div
                animate={{ x: [-100, window.innerWidth || 1000, -100] }}
                transition={{ duration: 120, repeat: Infinity, ease: "linear" }}
                className="absolute top-32 left-20 text-white/60"
              >
                <Cloud size={150} fill="currentColor" />
              </motion.div>
            </motion.div>
          ) : (
            <motion.div
              key="night"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              transition={{ duration: 1 }}
              className="absolute inset-0 overflow-hidden"
            >
              {/* Dynamic Moon */}
              <motion.div 
                className="absolute text-slate-200 drop-shadow-[0_0_30px_rgba(203,213,225,0.6)] opacity-90"
                animate={{ 
                  left: `${50 + moonPosition.x}%`, 
                  top: `${50 + moonPosition.y}%`,
                }}
                transition={{ 
                  left: { type: "spring", stiffness: 10, damping: 20 },
                  top: { type: "spring", stiffness: 10, damping: 20 },
                }}
                style={{ transform: 'translate(-50%, -50%)' }}
              >
                <Moon size={150} fill="currentColor" />
              </motion.div>
              {/* Stars */}
              {[...Array(50)].map((_, i) => (
                <motion.div
                  key={i}
                  animate={{ opacity: [0.1, 0.8, 0.1] }}
                  transition={{ duration: 2 + Math.random() * 4, repeat: Infinity, ease: "easeInOut", delay: Math.random() * 2 }}
                  className="absolute text-yellow-100"
                  style={{
                    top: `${Math.random() * 100}%`,
                    left: `${Math.random() * 100}%`,
                    transform: `scale(${0.3 + Math.random() * 0.7})`
                  }}
                >
                  <Star size={Math.random() > 0.8 ? 20 : 12} fill="currentColor" />
                </motion.div>
              ))}
            </motion.div>
          )}
        </AnimatePresence>
      </div>

      <div className="relative z-10 px-6 pt-6">
        <h1 className={`text-3xl font-bold mb-8 transition-colors duration-1000 ${isDayTime ? 'text-slate-800' : 'text-white'}`}>Dashboard Overview</h1>

        {loading && !dashboardData ? (
          <div className="flex items-center justify-center h-64">
            <Loader2 className="w-8 h-8 text-indigo-500 animate-spin" />
            <span className={`ml-3 ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>Loading data...</span>
          </div>
        ) : (
          <>
            {/* Top Info Cards */}
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
              <div className={`backdrop-blur-md border rounded-xl p-6 ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
                <p className={`${isDayTime ? 'text-slate-700' : 'text-slate-400'} text-sm font-medium`}>Dataset Rows</p>
                <h2 className={`text-3xl font-bold mt-2 ${isDayTime ? 'text-slate-900' : 'text-white'}`}>842,160</h2>
              </div>
              <div className={`backdrop-blur-md border rounded-xl p-6 ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
                <p className={`${isDayTime ? 'text-slate-700' : 'text-slate-400'} text-sm font-medium`}>Features</p>
                <h2 className={`text-3xl font-bold mt-2 ${isDayTime ? 'text-slate-900' : 'text-white'}`}>71</h2>
              </div>
              <div className={`backdrop-blur-md border rounded-xl p-6 ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
                <p className={`${isDayTime ? 'text-slate-700' : 'text-slate-400'} text-sm font-medium`}>ML Models Trained</p>
                <h2 className={`text-3xl font-bold mt-2 ${isDayTime ? 'text-blue-600' : 'text-indigo-400'}`}>10</h2>
              </div>
              
              {/* Live Weather Card */}
              <div className={`backdrop-blur-md border rounded-xl p-6 relative overflow-hidden ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
                <div className="absolute top-0 right-0 -mt-4 -mr-4 opacity-10 text-slate-800">
                  <Wind className="w-32 h-32" />
                </div>
                <div className="flex justify-between items-start">
                  <div>
                    <p className={`${isDayTime ? 'text-slate-700' : 'text-slate-400'} text-sm font-medium flex items-center`}>
                      <MapPin className="w-3 h-3 mr-1" />
                      {weatherData ? weatherData.city : 'Locating...'}
                    </p>
                    <div className="flex items-center mt-2">
                      <h2 className={`text-3xl font-bold mr-3 ${isDayTime ? 'text-slate-900' : 'text-white'}`}>
                        {weatherData ? `${weatherData.temperature}°C` : '--°C'}
                      </h2>
                    </div>
                    <p className={`${isDayTime ? 'text-slate-700' : 'text-slate-400'} text-xs mt-2`}>
                      {weatherData ? `Wind: ${weatherData.windspeed} km/h | Hum: ${weatherData.humidity}%` : 'Loading weather...'}
                    </p>
                  </div>
                  <motion.div 
                    animate={{ y: [0, -5, 0] }} 
                    transition={{ repeat: Infinity, duration: 3, ease: "easeInOut" }}
                  >
                    {weatherData ? getWeatherIcon(weatherData.weathercode) : <Loader2 className={`w-8 h-8 animate-spin ${isDayTime ? 'text-slate-700' : 'text-slate-500'}`} />}
                  </motion.div>
                </div>
                {permissionDenied && (
                  <p className="text-xs text-amber-600 mt-2 font-medium">Using default location (IP restricted).</p>
                )}
              </div>
            </div>

            {/* Insights Section: System Limitations & Daily Summary */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
              <div className={`lg:col-span-2 backdrop-blur-md border rounded-xl p-6 ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
                <div className="flex items-center mb-6">
                  <BookOpen className={`w-5 h-5 mr-2 ${isDayTime ? 'text-blue-600' : 'text-indigo-400'}`} />
                  <h3 className={`text-lg font-semibold ${isDayTime ? 'text-slate-900' : 'text-white'}`}>System Limitations & Optimal Solutions</h3>
                </div>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <h4 className={`font-medium mb-3 flex items-center ${isDayTime ? 'text-slate-800' : 'text-slate-200'}`}>
                      <span className="w-2 h-2 rounded-full bg-red-400 mr-2"></span>
                      Current System Drawbacks
                    </h4>
                    <ul className="space-y-3">
                      <li className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>
                        <strong className={`${isDayTime ? 'text-slate-900' : 'text-slate-300'}`}>Sparse Sensor Networks:</strong> Ground-level monitoring stations are expensive and unevenly distributed, leading to spatial gaps in AQI predictions.
                      </li>
                      <li className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>
                        <strong className={`${isDayTime ? 'text-slate-900' : 'text-slate-300'}`}>Temporal Lag:</strong> Traditional stationary sensors often report data with a 1-2 hour delay, making real-time intervention difficult.
                      </li>
                      <li className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>
                        <strong className={`${isDayTime ? 'text-slate-900' : 'text-slate-300'}`}>Single-Modal Data:</strong> Relying purely on historical tabular data ignores complex meteorological dispersion patterns and urban topography.
                      </li>
                    </ul>
                  </div>

                  <div>
                    <h4 className={`font-medium mb-3 flex items-center ${isDayTime ? 'text-slate-800' : 'text-slate-200'}`}>
                      <span className="w-2 h-2 rounded-full bg-emerald-500 mr-2"></span>
                      Research-Backed Optimal Solutions
                    </h4>
                    <ul className="space-y-3">
                      <li className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>
                        <strong className={`${isDayTime ? 'text-slate-900' : 'text-slate-300'}`}>Satellite Imagery Integration:</strong> Implementing multi-modal deep learning (e.g., CNNs on Sentinel-5P satellite data) alongside ground sensors provides high-resolution spatial coverage (Source: Zheng et al., 2021).
                      </li>
                      <li className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>
                        <strong className={`${isDayTime ? 'text-slate-900' : 'text-slate-300'}`}>Mobile Edge-IoT Sensors:</strong> Deploying low-cost sensors on public transport creates dynamic, real-time spatial mapping at a fraction of traditional costs.
                      </li>
                      <li className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>
                        <strong className={`${isDayTime ? 'text-slate-900' : 'text-slate-300'}`}>Graph Neural Networks (GNNs):</strong> Modeling monitoring stations as graph nodes captures spatial-temporal dependencies and wind propagation effects much better than LSTMs alone.
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              {/* Daily Summary & Alerts */}
              <div className={`backdrop-blur-md border rounded-xl p-6 flex flex-col ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
                <h3 className={`text-lg font-semibold mb-4 ${isDayTime ? 'text-slate-900' : 'text-white'}`}>Daily Summary</h3>
                
                <div className={`border rounded-lg p-4 mb-6 ${isDayTime ? 'bg-amber-100/50 border-amber-300' : 'bg-amber-500/10 border-amber-500/20'}`}>
                  <div className="flex items-start">
                    <div className={`p-2 rounded-full mr-3 shrink-0 ${isDayTime ? 'bg-amber-200' : 'bg-amber-500/20'}`}>
                      <Wind className={`w-4 h-4 ${isDayTime ? 'text-amber-700' : 'text-amber-400'}`} />
                    </div>
                    <div>
                      <h4 className={`font-medium text-sm mb-1 ${isDayTime ? 'text-amber-800' : 'text-amber-400'}`}>Local Air Quality Alert</h4>
                      <p className={`text-sm leading-relaxed ${isDayTime ? 'text-amber-900/80' : 'text-slate-300'}`}>
                        Air quality is poor today, with a peak of Very Unhealthy expected around 11 AM. Reduce prolonged outdoor exertion.
                      </p>
                    </div>
                  </div>
                </div>

                <div className="flex-1 space-y-4">
                  <div className={`flex justify-between items-center border-b pb-3 ${isDayTime ? 'border-slate-300' : 'border-slate-800'}`}>
                    <span className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>Primary Pollutant</span>
                    <span className={`font-medium text-sm ${isDayTime ? 'text-slate-900' : 'text-slate-200'}`}>PM2.5</span>
                  </div>
                  <div className={`flex justify-between items-center border-b pb-3 ${isDayTime ? 'border-slate-300' : 'border-slate-800'}`}>
                    <span className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>Avg Temperature</span>
                    <span className={`font-medium text-sm ${isDayTime ? 'text-slate-900' : 'text-slate-200'}`}>24°C</span>
                  </div>
                  <div className="flex justify-between items-center pb-3">
                    <span className={`text-sm ${isDayTime ? 'text-slate-700' : 'text-slate-400'}`}>Status</span>
                    <span className={`px-2 py-1 text-xs font-medium rounded-full border ${isDayTime ? 'bg-emerald-100 text-emerald-700 border-emerald-200' : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'}`}>
                      Sensors Online
                    </span>
                  </div>
                </div>
              </div>
            </div>

            {/* Forecast Bar Graph (At the Bottom) */}
            <div className={`backdrop-blur-md border rounded-xl p-6 mb-8 ${isDayTime ? 'bg-white/40 border-white/60 shadow-lg' : 'bg-slate-900/80 border-slate-700/50'}`}>
              <div className="flex justify-between items-center mb-6">
                <h3 className={`text-lg font-semibold ${isDayTime ? 'text-slate-900' : 'text-white'}`}>Aggregate AQI Category Distribution</h3>
                <span className={`px-3 py-1 text-xs font-medium rounded-full border ${isDayTime ? 'bg-blue-100 text-blue-700 border-blue-200' : 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20'}`}>
                  Global Dataset
                </span>
              </div>
              <div className="w-full h-[300px]">
                {chartData && chartData.length > 0 ? (
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={chartData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke={isDayTime ? '#cbd5e1' : '#334155'} vertical={false} />
                      <XAxis dataKey="name" stroke={isDayTime ? '#475569' : '#94a3b8'} tick={{fontSize: 12}} />
                      <YAxis stroke={isDayTime ? '#475569' : '#94a3b8'} tick={{fontSize: 12}} />
                      <Tooltip 
                        cursor={{fill: isDayTime ? '#f1f5f9' : '#1e293b'}} 
                        contentStyle={{backgroundColor: isDayTime ? '#ffffff' : '#0f172a', borderColor: isDayTime ? '#e2e8f0' : '#334155', color: isDayTime ? '#0f172a' : '#f8fafc', borderRadius: '0.5rem'}} 
                        itemStyle={{color: isDayTime ? '#4f46e5' : '#818cf8'}}
                      />
                      <Bar dataKey="count" fill={isDayTime ? '#3b82f6' : '#6366f1'} radius={[4, 4, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                ) : (
                  <div className={`flex items-center justify-center h-full ${isDayTime ? 'text-slate-500' : 'text-slate-400'}`}>
                    Loading distribution data...
                  </div>
                )}
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  );
};

export default Dashboard;
